# BlindSession Environment Configuration
# Copy this file to .env and update values for your setup.
# The .env file is gitignored and never committed to the repository.

# Server port
PORT=3000

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/encrypted_chat_db

# Environment: development or production
NODE_ENV=development

# Database SSL: true for managed DBs (Railway/Render), false for local/Docker
DB_SSL=false
